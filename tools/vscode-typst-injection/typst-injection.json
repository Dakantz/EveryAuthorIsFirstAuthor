{
  "scopeName": "latex.typst.injection",
  "injectionSelector": "L:text.tex.latex",
  "patterns": [
    {
      "comment": "Body of the typst environment from paper/typst.sty",
      "begin": "(\\\\begin\\{typst\\})(\\{[^}]*\\})?",
      "end": "(\\\\end\\{typst\\})",
      "beginCaptures": {
        "1": { "name": "support.function.be.latex" },
        "2": { "name": "meta.group.brace.latex" }
      },
      "endCaptures": { "1": { "name": "support.function.be.latex" } },
      "contentName": "meta.embedded.block.typst",
      "patterns": [{ "include": "source.typst" }]
    }
  ]
}
