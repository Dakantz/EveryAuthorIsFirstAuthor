# pdflatex with shell escape (minted, typst.sty); overrides /etc/LatexMk's lualatex
$pdf_mode = 1;
set_tex_cmds('-shell-escape %O %S');
# latexminted 0.6.0 crashes on Python 3.14; use a 3.13 wrapper where one exists
my $shim = "$ENV{HOME}/.local/share/latexminted-py313";
$ENV{PATH} = "$shim:$ENV{PATH}" if -d $shim;
